msgstr "更多語言"

msgid "My Collection"
msgstr "我的收藏"

msgid "Logout"
msgstr "登出"

msgid "Login"
msgstr "登入"

msgid "Login to Jokelingo"
msgstr "登入 Jokelingo"

msgid "Sign in to mark posts as helpful or confusing; and later, to create your own posts. We will never post anything on your behalf."
msgstr "登入以標記貼文；之後的更新時，您可以建立自己的貼文。我們絕不會代表您發布任何內容。"

msgid "Continue with Google"
msgstr "使用 Google 繼續"

msgid "Loading feed..."
msgstr "載入動態消息中..."

msgid "Loading collection..."
msgstr "載入收藏中..."

