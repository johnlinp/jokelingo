#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
GEOIP_DIR="$ROOT_DIR/vendor/geoip"
MMDB_PATH="$GEOIP_DIR/dbip-country-lite.mmdb"
TMP_DIR="$(mktemp -d)"

cleanup() {
  rm -rf "$TMP_DIR"
}

trap cleanup EXIT

download_dbip_lite_db() {
  mkdir -p "$GEOIP_DIR"

  echo "Downloading DB-IP Lite country database"
  curl -fsSL "https://download.db-ip.com/free/dbip-country-lite-2026-08.mmdb.gz" -o "$TMP_DIR/dbip-country-lite.mmdb.gz"
  gunzip -c "$TMP_DIR/dbip-country-lite.mmdb.gz" > "$MMDB_PATH"

  echo "Stored DB-IP Lite country DB at $MMDB_PATH"
}

download_dbip_lite_db
python manage.py compilemessages
