msgstr "點擊貼文上的 \"讚!\" 就可以存在這裡"

msgid "Translation"
msgstr "翻譯"

msgid "Why is it funny?"
msgstr "這有什麼好笑？"

msgid "click me"
msgstr "點我"

msgid "helpful"
msgstr "讚!"

msgid "confusing"
msgstr "蛤?"

