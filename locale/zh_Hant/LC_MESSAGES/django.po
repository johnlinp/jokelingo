msgid "Laugh in every language"
msgstr "用各種語言大笑"

msgid "Discover jokes, puns, and wordplay from different languages with explanations and translations that help you understand why they are funny."
msgstr "探索不同語言的笑話、雙關語和文字遊戲，搭配說明與翻譯，讓你搞懂笑點在哪。"

msgid "Spanish → English"
msgstr "西班牙文 → 英文"

msgid "French → English"
msgstr "法文 → 英文"

msgid "Japanese → English"
msgstr "日文 → 英文"

msgid "Korean → English"
msgstr "韓文 → 英文"

msgid "Japanese → Traditional Chinese"
msgstr "日文 → 正體中文"

msgid "Korean → Traditional Chinese"
msgstr "韓文 → 正體中文"

msgid "Spanish → Traditional Chinese"
msgstr "西班牙文 → 正體中文"

msgid "More Languages"
msgstr "更多語言"

msgid "My Collection"
msgstr "我的收藏"

msgid "Logout"
msgstr "登出"

msgid "Login"
msgstr "登入"

msgid "Login to Jokelingo"
msgstr "登入 Jokelingo"

msgid "Sign in to react to jokes, save the ones you love, and share laughs of your own!"
msgstr "登入後就能參與互動並收藏喜歡的貼文，還能分享自己的笑話！"

msgid "Continue with Google"
msgstr "使用 Google 繼續"

msgid "Loading feed..."
msgstr "載入動態消息中..."

msgid "Loading collection..."
msgstr "載入收藏中..."

msgid "Posts you've marked as helpful"
msgstr "您存起來的貼文"

msgid "Back to home"
msgstr "回到首頁"

msgid "Almost there!"
msgstr "再等幾天就可以發文囉！"

#, python-format
msgid "New here? We ask everyone to spend their first %(minimum_age)s days getting to know Jokelingo before posting. It helps keep the community fun and useful. You can publish after %(eligible_date)s."
msgstr "剛加入嗎？我們希望大家先花 %(minimum_age)s 天逛逛 Jokelingo、熟悉一下這裡，再開始發文。這樣能讓社群保持有趣又實用。你可以在 %(eligible_date)s 後發文。"

msgid "No posts found."
msgstr "找不到貼文"

msgid "Load More"
msgstr "載入更多"

msgid "Error loading feed:"
msgstr "載入動態時發生錯誤："

msgid "Error loading collection:"
msgstr "載入收藏時發生錯誤："

msgid "Click Helpful on a post to save it here."
msgstr "點擊貼文上的 \"讚!\" 就可以存在這裡"

msgid "Translation"
msgstr "翻譯"

msgid "Why is it funny?"
msgstr "這有什麼好笑？"

msgid "click me"
msgstr "點我"

msgid "helpful"
msgstr "讚!"

msgid "confusing"
msgstr "蛤?"

msgid "By"
msgstr "由"

msgid "Loading embedded post..."
msgstr "載入嵌入貼文中..."

msgid "You haven't added anything to your collection yet."
msgstr "您尚未將任何內容加入收藏"

msgid "Korean"
msgstr "韓文"

msgid "Japanese"
msgstr "日文"

msgid "Traditional Chinese"
msgstr "正體中文"

msgid "Spanish"
msgstr "西班牙文"

msgid "English"
msgstr "英文"

msgid "French"
msgstr "法文"

msgid "Create Post"
msgstr "建立貼文"

msgid "Add a new joke post with translation and context."
msgstr "建立一則笑話貼文，並補上翻譯與背景說明。"

msgid "Create a Post"
msgstr "建立貼文"

msgid "Source post URL"
msgstr "來源貼文連結"

msgid "Language"
msgstr "語言"

msgid "Live Preview"
msgstr "貼文預覽"

msgid "Add a source URL to see a preview."
msgstr "貼上來源貼文連結即可預覽。"

msgid "Enter a supported source URL."
msgstr "請輸入支援的貼文連結。"

msgid "That language pair is not supported yet."
msgstr "此語言組合目前尚未支援。"

msgid "Either translation or explanation is required."
msgstr "請至少填寫翻譯或笑點說明。"

msgid "Publish Post"
msgstr "發布貼文"

msgid "Publishing..."
msgstr "正在發布..."

msgid "Post published successfully."
msgstr "貼文已發布。"

msgid "Only Reddit, Instagram, X/Twitter, Imgur, and Facebook URLs are supported right now."
msgstr "目前僅支援 Reddit、Instagram、X/Twitter、Imgur 與 Facebook 的貼文連結。"
