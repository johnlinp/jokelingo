msgid "Laugh in every language"
msgstr "用各種語言大笑"

msgid "Discover jokes, puns, and wordplay from different languages with explanations and translations that help you understand why they are funny."
msgstr "探索不同語言的笑話、雙關語和文字遊戲，搭配說明與翻譯，讓你搞懂笑點在哪。"

msgid "Spanish → English"
msgstr "西班牙文 → 英文"

msgid "French → English"
msgstr "法文 → 英文"

msgid "Korean → English"
msgstr "韓文 → 英文"

msgid "Korean → Traditional Chinese"
msgstr "韓文 → 正體中文"

msgid "Spanish → Traditional Chinese"
msgstr "西班牙文 → 正體中文"

